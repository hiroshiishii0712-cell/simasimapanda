{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "WebSearch",
      "WebFetch",
      "Skill",
      "Agent(evaluator)",
      "Agent(researcher)",
      "Agent(archiver)",
      "Agent(skeptic)",
      "Agent(architect)",
      "Agent(minimalist)",
      "Agent(Explore)",
      "Agent(general-purpose)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Write",
      "Edit",
      "mcp__gmail__create_draft",
      "mcp__gmail__send_message",
      "mcp__googlecalendar__create_event",
      "mcp__googlecalendar__update_event",
      "mcp__googlecalendar__delete_event",
      "mcp__notion__notion-create-pages",
      "mcp__notion__notion-update-page",
      "mcp__googledrive__create_file",
      "mcp__googledrive__copy_file"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(curl * | sh:*)",
      "Bash(curl * | bash:*)",
      "Bash(wget * | sh:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-compact-backup.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/stop-hook-git-check.sh"
          }
        ]
      }
    ]
  }
}
